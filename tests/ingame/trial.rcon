# Trial of the Soul with a test bot. The bot can't fight, so each wave is killed by command. Waves spawn
# 60 ticks after the start and 40 ticks after the previous one; the `neoforge tps` lines only pass time.
# Expect: step=trial while running, then step=race with ttl.trial.passed=true, then step=unique with three
# ttl.uniqueOptions from the "knowledge" pool. The log shows "[ttl] trial TtlBotTrial: wave N, X left".
ttlbot spawn TtlBotTrial
neoforge tps
neoforge tps
kill TtlBotTrial
execute as TtlBotTrial run ttl wish knowledge
execute as TtlBotTrial run ttl trial
ttl inspect TtlBotTrial
neoforge tps
neoforge tps
neoforge tps
neoforge tps
kill @e[tag=ttl_trial]
neoforge tps
neoforge tps
neoforge tps
kill @e[tag=ttl_trial]
neoforge tps
neoforge tps
neoforge tps
kill @e[tag=ttl_trial]
neoforge tps
ttl inspect TtlBotTrial
execute as TtlBotTrial run ttl choose slime
ttl inspect TtlBotTrial
ttl reset TtlBotTrial
ttlbot remove TtlBotTrial
