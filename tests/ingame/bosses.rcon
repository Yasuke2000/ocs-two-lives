# Boss framework (bosses/boss.js, design/data/bosses.toml, S2 in design/architecture/sprint3-4.md). Every `ttl boss expect`
# prints "ttl: ..." when it does not hold (counted as a failure by `server.sh test-all`); `execute if entity` prints
# "Test passed" / "Test failed". The lines marked FAILS below are expected to say "Test failed".
# Parts 3 and 4 (spawn conditions, party credit) are the story-characters WP-S3 additions; tests/ingame/wild.rcon covers the wild roll.
# Part 5 is WP-W2 (world-state.md §7.1): per-party cooldowns, the arena queue, max_per_party, echoes. The cooldown asserted in
# Part 1 is now the cooldown of the bot's own party (here: the bot alone), never a server-wide one.
# Part 1 runs in the Spirit Corridor hall (the Mortal Realm blocks Tensura mobs; a Life 1 bot may stand there).
# Expect in the log: "[ttl] boss: orc_lord summoned (hp ×..., 1 player)", "[ttl] boss: orc_lord awake ...",
# "[ttl] boss: orc_lord phase 1 at 60% health", "[ttl] boss: orc_lord defeated by TtlBotBoss (no kill credit: ...)".
ttlbot spawn TtlBotBoss
@sleep 2
gamemode creative TtlBotBoss
ttl boss reset TtlBotBoss
ttl boss abort
ttl boss cooldown clear all
execute in ttl:spirit_corridor run tp TtlBotBoss 0.5 65 0.5
ttl boss list
ttl boss expect TtlBotBoss stage t1 no
ttl boss expect TtlBotBoss kills orc_lord 0
ttl boss expect TtlBotBoss active orc_lord no
# Summon at explicit coordinates in the dimension the command runs in; the entity appears once its chunk is loaded.
execute in ttl:spirit_corridor run ttl boss summon orc_lord 0 66 8
@until 30 ttl boss expect TtlBotBoss active orc_lord yes
execute in ttl:spirit_corridor if entity @e[tag=ttl.boss,tag=ttl.bossid.orc_lord,limit=1]
# Scaled: Health above the vanilla value (compare with `data get entity <an unscaled tensura:orc_lord> Health`); the bot
# stands within range, so the boss has woken (NoAI:0b).
execute in ttl:spirit_corridor run data get entity @e[tag=ttl.boss,limit=1] Health
execute in ttl:spirit_corridor run data get entity @e[tag=ttl.boss,limit=1] NoAI
# The boss must have been polled with the bot in range before it dies: a boss killed before its first poll (a lag spike
# delays the summon) is "lost without a fight" and pays nobody (ttl-ops run of 785036f, 19/11/2026).
@until 30 ttl boss expect TtlBotBoss fighting orc_lord yes
# Phase 1 (60%): drop the boss to 1 health; the horde must appear and carry the minion tag.
execute in ttl:spirit_corridor run data modify entity @e[tag=ttl.boss,limit=1] Health set value 1.0f
@sleep 3
execute in ttl:spirit_corridor if entity @e[tag=ttl.boss.minion]
# A /kill has no player behind it, so the boss dies without kill credit and the fighters in range share the reward.
execute in ttl:spirit_corridor run kill @e[tag=ttl.boss,tag=ttl.bossid.orc_lord]
@until 30 ttl boss expect TtlBotBoss active orc_lord no
ttl boss expect TtlBotBoss stage t1 yes
ttl boss expect TtlBotBoss defeated orc_lord yes
ttl boss expect TtlBotBoss kills orc_lord 1
ttl discord expect TtlBotBoss boss 1
ttl boss expect TtlBotBoss active orc_lord no
ttl boss expect TtlBotBoss cooldown orc_lord yes
# Boss and minions are gone: FAILS (Test failed) for both.
execute in ttl:spirit_corridor if entity @e[tag=ttl.boss]
execute in ttl:spirit_corridor if entity @e[tag=ttl.boss.minion]
# Gating: Rimuru Tempest needs the stage ttl.defeated.shizu in the summoner.
ttl boss expect TtlBotBoss gate rimuru_ogre_fight no
kubejs stages add TtlBotBoss ttl.defeated.shizu
ttl boss expect TtlBotBoss gate rimuru_ogre_fight yes
ttl boss expect TtlBotBoss gate shizu yes
ttl boss reset TtlBotBoss
ttl boss expect TtlBotBoss stage t1 no
ttl boss expect TtlBotBoss defeated shizu no
# Part 2: the Tempest arena (Overworld 0 0, radius 48). No players there, so Shizu stays asleep until aborted.
ttl boss summon shizu
@until 30 ttl boss expect TtlBotBoss active shizu yes
execute in minecraft:overworld if entity @e[tag=ttl.boss,tag=ttl.bossid.shizu]
ttl boss list
ttl boss abort shizu
@until 30 ttl boss expect TtlBotBoss active shizu no
# Gone again: FAILS (Test failed).
execute in minecraft:overworld if entity @e[tag=ttl.boss,tag=ttl.bossid.shizu]
# Refused outside the arena by design (prints "ttl: Shizu ... can only be summoned within 48 blocks"), so not run here:
#   execute in minecraft:overworld run ttl boss summon shizu <a spot 500 blocks from Tempest> 70 <...>
# Part 3: every boss has a fixed spawn (kind + place) and a condition on the SUMMONER (never a story path). `spawn.stages` and
# `requires` both gate; a wild-only boss has no fixed spawn.
ttl boss expect TtlBotBoss spawn orc_lord altar
ttl boss expect TtlBotBoss spawn shizu quest
ttl boss expect TtlBotBoss spawn gazel_dwargo statue
ttl boss expect TtlBotBoss spawn folgen event
ttl boss expect TtlBotBoss spawn elemental_colossus none
ttl boss reset TtlBotBoss
ttl boss expect TtlBotBoss gate hinata_sakaguchi no
ttl boss expect TtlBotBoss gate ifrit no
ttl boss expect TtlBotBoss gate orc_disaster no
ttl boss expect TtlBotBoss gate veldora no
ttl boss expect TtlBotBoss gate luminous_valentine no
kubejs stages add TtlBotBoss ttl.defeated.shizu
ttl boss expect TtlBotBoss gate hinata_sakaguchi yes
ttl boss expect TtlBotBoss gate ifrit yes
kubejs stages add TtlBotBoss ttl.defeated.orc_lord
ttl boss expect TtlBotBoss gate orc_disaster yes
# A path stage never opens or closes a gate: anyone may fight any boss.
kubejs stages add TtlBotBoss ttl.path.dark
ttl boss expect TtlBotBoss gate gazel_dwargo yes
kubejs stages remove TtlBotBoss ttl.path.dark
ttl boss reset TtlBotBoss
# A build is a valid place: Kyoya's fixed spawn is the Marris build (its placed anchor, else the canon x/z, on the surface).
# Nobody is near, so he stays asleep until aborted. Chunk generation can take a few seconds.
ttl boss summon kyoya_tachibana
@until 30 ttl boss expect TtlBotBoss active kyoya_tachibana yes
ttl boss list
ttl boss abort kyoya_tachibana
@until 30 ttl boss expect TtlBotBoss active kyoya_tachibana no
ttlbot remove TtlBotBoss
# Part 4: party credit (boss.js finish). Carrion (tier 3, Skill Core) is summoned in the Spirit Corridor next to three Life 2 bots.
# A deals the killing blow; B and C only stand there (not contributors: they were in range for a few seconds, not 15).
# Without a party B and C get nothing. With the test party A + B + C (`ttl boss testparty`, a real FTB party team behaves the
# same) all three get the stage, kill and coins, A keeps its own Skill Core and exactly one of B / C gets the party core
# (core_per_party = 1). Carrion shrugs off the first lethal blow and is invulnerable for ~4 s after it (Tensura's own
# mechanic, measured on staging 18/11/2026), so every kill below is two hits 5 s apart. Expect in the log: "[ttl] boss: carrion party credit for TtlBotPtyB (party of TtlBotPtyA, Skill Core)".
ttlbot spawn TtlBotPtyA
ttlbot spawn TtlBotPtyB
ttlbot spawn TtlBotPtyC
@sleep 2
gamemode creative TtlBotPtyA
gamemode creative TtlBotPtyB
gamemode creative TtlBotPtyC
kubejs stages add TtlBotPtyA ttl.life2
kubejs stages add TtlBotPtyB ttl.life2
kubejs stages add TtlBotPtyC ttl.life2
ttl boss reset TtlBotPtyA
ttl boss reset TtlBotPtyB
ttl boss reset TtlBotPtyC
clear TtlBotPtyA ttl:skill_core
clear TtlBotPtyB ttl:skill_core
clear TtlBotPtyC ttl:skill_core
ttl boss testparty clear
execute in ttl:spirit_corridor run tp TtlBotPtyA 0.5 65 0.5
execute in ttl:spirit_corridor run tp TtlBotPtyB 0.5 65 2.5
execute in ttl:spirit_corridor run tp TtlBotPtyC 2.5 65 0.5
execute in ttl:spirit_corridor run ttl boss summon carrion 0 66 8
@until 30 ttl boss expect TtlBotPtyA active carrion yes
@until 30 ttl boss expect TtlBotPtyA fighting carrion yes
execute in ttl:spirit_corridor run damage @e[tag=ttl.boss,tag=ttl.bossid.carrion,limit=1] 1000000 minecraft:player_attack by TtlBotPtyA
@sleep 5
execute in ttl:spirit_corridor run damage @e[tag=ttl.boss,tag=ttl.bossid.carrion,limit=1] 1000000 minecraft:player_attack by TtlBotPtyA
@until 30 ttl boss expect TtlBotPtyA active carrion no
ttl boss expect TtlBotPtyA stage t3 yes
ttl boss expect TtlBotPtyA kills carrion 1
ttl boss expect TtlBotPtyA cores - 1
ttl boss expect TtlBotPtyB stage t3 no
ttl boss expect TtlBotPtyC stage t3 no
ttl boss expect TtlBotPtyB cores TtlBotPtyC 0
# Round 2: the same fight as a party.
ttl boss reset TtlBotPtyA
ttl boss reset TtlBotPtyB
ttl boss reset TtlBotPtyC
clear TtlBotPtyA ttl:skill_core
ttl boss testparty set TtlBotPtyA TtlBotPtyB TtlBotPtyC
execute in ttl:spirit_corridor run ttl boss summon carrion 0 66 8
@until 30 ttl boss expect TtlBotPtyA fighting carrion yes
execute in ttl:spirit_corridor run damage @e[tag=ttl.boss,tag=ttl.bossid.carrion,limit=1] 1000000 minecraft:player_attack by TtlBotPtyA
@sleep 5
execute in ttl:spirit_corridor run damage @e[tag=ttl.boss,tag=ttl.bossid.carrion,limit=1] 1000000 minecraft:player_attack by TtlBotPtyA
@until 30 ttl boss expect TtlBotPtyA active carrion no
ttl boss expect TtlBotPtyA stage t3 yes
ttl boss expect TtlBotPtyB stage t3 yes
ttl boss expect TtlBotPtyC stage t3 yes
ttl boss expect TtlBotPtyB defeated carrion yes
ttl boss expect TtlBotPtyC kills carrion 1
ttl boss expect TtlBotPtyA cores - 1
ttl boss expect TtlBotPtyB cores TtlBotPtyC 1
# A bystander who is NOT in the party (a fourth player outside the test party) would get nothing: covered by round 1.
ttl boss testparty clear
ttl boss reset TtlBotPtyA
ttl boss reset TtlBotPtyB
ttl boss reset TtlBotPtyC
clear TtlBotPtyA ttl:skill_core
clear TtlBotPtyB ttl:skill_core
clear TtlBotPtyC ttl:skill_core
kubejs stages remove TtlBotPtyA ttl.life2
kubejs stages remove TtlBotPtyB ttl.life2
kubejs stages remove TtlBotPtyC ttl.life2
# No cooldown left behind: story.rcon and wild.rcon summon / roll the Orc Lord after this test.
ttl boss cooldown clear orc_lord
ttl boss cooldown clear carrion
ttlbot remove TtlBotPtyA
ttlbot remove TtlBotPtyB
ttlbot remove TtlBotPtyC
# Part 5: instancing (WP-W2). A and B (a test party) kill the Orc Lord in the Spirit Corridor; C, elsewhere and in no party, is
# not locked out by it. Expect in the log: "[ttl] boss: gazel_dwargo queue: the party of TtlBotInsC is number 1 for ...",
# "[ttl] boss: gazel_dwargo queue: the arena ... is free, held for the party of TtlBotInsC", "[ttl] boss: the statue ttl_gazel
# steps aside for gazel_dwargo (n removed)" and "[ttl] boss: shizu summoned (an echo) (hp ...)".
ttlbot spawn TtlBotInsA
ttlbot spawn TtlBotInsB
ttlbot spawn TtlBotInsC
@sleep 2
gamemode creative TtlBotInsA
gamemode creative TtlBotInsB
gamemode creative TtlBotInsC
kubejs stages add TtlBotInsA ttl.life2
kubejs stages add TtlBotInsB ttl.life2
kubejs stages add TtlBotInsC ttl.life2
ttl boss reset TtlBotInsA
ttl boss reset TtlBotInsB
ttl boss reset TtlBotInsC
ttl boss abort
ttl boss cooldown clear all
ttl boss arena clear all
ttl boss testparty set TtlBotInsA TtlBotInsB
execute in ttl:spirit_corridor run tp TtlBotInsA 0.5 65 0.5
execute in ttl:spirit_corridor run tp TtlBotInsB 0.5 65 2.5
execute in minecraft:overworld run tp TtlBotInsC ${anchor:arrival.x} 120 ${anchor:arrival.z}
execute in ttl:spirit_corridor run ttl boss summon orc_lord 0 66 8
@until 30 ttl boss expect TtlBotInsA active orc_lord yes
@until 30 ttl boss expect TtlBotInsA fighting orc_lord yes
execute in ttl:spirit_corridor run kill @e[tag=ttl.boss,tag=ttl.bossid.orc_lord]
@until 30 ttl boss expect TtlBotInsA active orc_lord no
ttl boss expect TtlBotInsA defeated orc_lord yes
ttl boss expect TtlBotInsB defeated orc_lord yes
# The cooldown is the party's: A and B are on it, C (another party) is not, and nothing server-wide stops C.
ttl boss expect TtlBotInsA cooldown orc_lord yes
ttl boss expect TtlBotInsB cooldown orc_lord yes
ttl boss expect TtlBotInsC cooldown orc_lord no
ttl boss expect TtlBotInsA cansummon orc_lord no
ttl boss expect TtlBotInsC cansummon orc_lord yes
# A party is on cooldown while ANY member is: C joins A and inherits it, leaves and is free again.
ttl boss testparty set TtlBotInsA TtlBotInsC
ttl boss expect TtlBotInsC cooldown orc_lord yes
ttl boss testparty clear
ttl boss expect TtlBotInsC cooldown orc_lord no
# C alone starts the story fight at the orc camp (ops form: from anywhere). Nobody stands there, so Geld waits asleep.
ttl story fight orc_lord TtlBotInsC
@until 30 ttl boss expect TtlBotInsC active orc_lord yes
ttl boss expect TtlBotInsC story orc_lord yes
# max_per_party = 1: C's party already has a boss out, so a second one is refused (not queued).
ttl boss expect TtlBotInsC cansummon shizu no
ttl boss abort orc_lord
@until 30 ttl boss expect TtlBotInsC cansummon shizu yes
# The arena queue: an ops Gazel holds his throne-room arena; C asks for the same fight and is put in line (a plain refusal line
# with the place and the ETA, not a "ttl:" failure). The seated king steps aside while the fight is out: the next line FAILS
# (Test failed) whether Dwargon is placed or not; it would pass only if the statue had stayed.
ttl boss summon gazel_dwargo
@until 30 ttl boss expect TtlBotInsC active gazel_dwargo yes
ttl boss expect TtlBotInsC busy gazel_dwargo yes
execute in minecraft:overworld if entity @e[tag=ttl_gazel]
ttl story fight gazel_dwargo TtlBotInsC
ttl boss expect TtlBotInsC queued gazel_dwargo yes
ttl boss expect TtlBotInsC ready gazel_dwargo no
ttl boss queue
# The arena frees: the head of the line is pinged and the arena is held for it (queue_ttl_minutes); A, not in line, must wait.
ttl boss abort gazel_dwargo
@until 30 ttl boss expect TtlBotInsC ready gazel_dwargo yes
ttl boss expect TtlBotInsC queued gazel_dwargo no
ttl boss expect TtlBotInsC ready gazel_dwargo yes
ttl boss expect TtlBotInsA busy gazel_dwargo yes
ttl boss expect TtlBotInsC busy gazel_dwargo no
# C fights it at the throne room (anchor `dwargon_throne`; the city is carved into the Canaat since the import, so the surface
# above it is not the hall: this test only starts and aborts the fight): a boss with no player in range is lost after a moment
# ("lost without a fight").
execute in minecraft:overworld positioned ${anchor:dwargon_throne.x} 0 ${anchor:dwargon_throne.z} positioned over motion_blocking_no_leaves run tp TtlBotInsC ~ ~ ~
ttl story fight gazel_dwargo TtlBotInsC
@until 30 ttl boss expect TtlBotInsC active gazel_dwargo yes
ttl boss expect TtlBotInsC ready gazel_dwargo no
ttl boss abort gazel_dwargo
@sleep 2
# Echo: a boss the world has seen fall (the chronicle's firsts; here the test hook) is fought as an echo, "Echo · " on its name
# and boss bar. The ops summon has no summoner, so its health is not lowered (echo_hp_mult is for parties behind in the story).
ttl boss testecho set shizu
ttl boss summon shizu
@sleep 4
ttl boss expect TtlBotInsC echo shizu yes
ttl boss expect TtlBotInsC story shizu yes
ttl boss list
ttl boss abort shizu
ttl boss testecho clear
@until 30 ttl boss expect TtlBotInsC active shizu no
# Clean up.
ttl boss abort
ttl boss queue clear
ttl boss arena clear all
ttl boss cooldown clear all
ttl boss testparty clear
ttl boss reset TtlBotInsA
ttl boss reset TtlBotInsB
ttl boss reset TtlBotInsC
kubejs stages remove TtlBotInsA ttl.life2
kubejs stages remove TtlBotInsB ttl.life2
kubejs stages remove TtlBotInsC ttl.life2
ttlbot remove TtlBotInsA
ttlbot remove TtlBotInsB
ttlbot remove TtlBotInsC
