# Trial of Hunger with a test bot. Expect food=4 at the start, then saturation fills it: passed=true.
ttlbot spawn TtlBotHun
@sleep 2
kill TtlBotHun
execute as TtlBotHun run ttl wish hunger
execute as TtlBotHun run ttl trial
@sleep 3
ttl inspect TtlBotHun
effect give TtlBotHun minecraft:saturation 2 20 true
@sleep 2
ttl inspect TtlBotHun
ttl reset TtlBotHun
ttlbot remove TtlBotHun
