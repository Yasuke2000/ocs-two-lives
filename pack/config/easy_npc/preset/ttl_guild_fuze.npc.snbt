              Actions:[
                {
                  Cmd:"/ttl guild take 1 fuze",
                  ExecAsUser:1b,
                  PermLevel:0,
                  Type:"COMMAND"
                },
                {
                  Type:"CLOSE_DIALOG"
                }
              ],
