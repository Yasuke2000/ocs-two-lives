            }
          ],
          Label:"take",
          Name:"Contracts",
          Priority:-1,
          Texts:[
            {
              Text:"Name the number. A contract taken is a contract owed, @initiator. I don't pay twice for the same failure, and I don't carry people who quit."
            }
          ]
