	task.59A48D780299F806.title: "In the queue at the gate"
	task.5C10DCC57776B9A0.title: "The Sealed Cave"
	task.5C3AEA5E41D1FD64.title: "I understand"
	task.5F028AE14A531A30.title: "25 trades"
	task.6353F26519B81BE6.title: "The goblins' campfire"
	task.63A16DEBE36C0D68.title: "Survive 2 days"
	task.63B04FCBF569A58C.title: "The Orc War battlefield"
	task.65C872A22AD97F93.title: "Survive 1 day"
	task.66B3DE5D9BA3FBB2.title: "The village green"
